# Copy to .env.local and fill in. .env* is gitignored.
#
# One set of variables serves both sides:
#   - tolgee.config.cjs reads them for the CLI (`bun run i18n:pull` / `i18n:push`)
#   - the app reads TOLGEE_API_URL / TOLGEE_API_KEY for in-context editing,
#     via `envPrefix` in vite.config.ts
#
# The app only uses them in development. Production builds render entirely
# from the JSON files in src/i18n/ and never call the instance.

TOLGEE_API_URL=https://tolgee.example.com
TOLGEE_PROJECT_ID=
# Project API Key, from <instance> -> your project -> Integrate.
# A Personal Access Token works too, and then TOLGEE_PROJECT_ID is required.
TOLGEE_API_KEY=

# Canonical origin used for canonical links and the absolute og:image /
# twitter:image URLs. Set this per environment, preview deploys included.
# Unset, the app uses http://localhost:3000 in dev and the production origin
# in a build — so social tags resolve locally instead of naming a host that
# is not deployed yet.
VITE_SITE_URL=
