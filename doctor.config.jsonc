{
  "$schema": "https://react.doctor/schema/config.json",

  // Documented false positives, verified 2026-08-23 against react-doctor 0.9.12.
  //
  // Every entry below is a finding that was traced to source and found not to
  // describe a real defect. Each is scoped to the narrowest file set that covers
  // it via `ignore.overrides`, so the rule keeps running everywhere else — none
  // of these is disabled globally.
  //
  // `overrides` matches files, not lines. A *new* violation of the same rule in
  // the same file would also be hidden, so re-verify an entry when the file's
  // role changes, and delete the entry outright if the code it describes goes away.
  "ignore": {
    "overrides": [
      {
        // no-prevent-default (lines 213, 237) — the two <form onSubmit> handlers
        // are copy-pasted stock shadcn `dashboard-01` demo content, rendered in
        // the widget gallery via src/components/gallery/dashboard-view.tsx.
        //
        // The "save" is `toast.promise(new Promise(resolve => setTimeout(resolve, 1000)))`
        // — a one-second timer that shows "Saving…" then "Done". Nothing is sent
        // anywhere: there is no endpoint, no mutation, no persistence. The rule's
        // premise (a server mutation that should degrade without JS) does not hold,
        // and the canonical recipe explicitly allows onSubmit + preventDefault for
        // client-only flows.
        //
        // Converting to <form action={...}> would also regress the demo: React 19
        // resets uncontrolled fields after an action completes, and these inputs
        // use `defaultValue`, so an edited value would snap back on submit.
        "files": ["src/components/data-table.tsx"],
        "rules": ["react-doctor/no-prevent-default"]
      },
      {
        // js-combine-iterations — data-table.tsx:461 (table columns in a dropdown,
        // ~7 items, built only while the menu is open) and chart.tsx:198 / :295
        // (recharts tooltip and legend payloads, typically 1-5 items, on hover).
        //
        // Two passes over a handful of items is not measurable, and the rule's own
        // recipe requires a production profile showing the traversal is material
        // before rewriting: "For ordinary collections, the readable chain is often
        // the better tradeoff." No such profile exists, because there is nothing
        // to profile at these sizes.
        //
        // Both files are vendored shadcn components. Rewriting them into reduce /
        // for...of loops makes them diverge from upstream, so the next `shadcn add`
        // clobbers the change or forces a manual merge — permanently, for no gain.
        "files": [
          "src/components/data-table.tsx",
          "src/components/ui/chart.tsx"
        ],
        "rules": ["react-doctor/js-combine-iterations"]
      },
      {
        // exhaustive-deps (line 42) — `useMemo(() => paletteScales(state), [rampKey])`
        // reads `state` but re-runs on `rampKey`, which the rule reads as stale-prone.
        //
        // Traced: paletteScales -> scaleFor -> fieldsFor(state, role) -> buildScale.
        // buildScale reads exactly base, chroma, hueShift, spread, anchor, overrides
        // (gamut is not on RoleFields — it is a module constant, so not reactive).
        // rampSignature calls the SAME fieldsFor, strips only `name`, and stringifies
        // the rest. `name` never reaches buildScale's destructure, and `state.active`
        // is never read by paletteScales.
        //
        // So rampKey is a strict superset of the memo's real inputs: there is no pair
        // of renders where the scales differ but the signature matches. It cannot go
        // stale. The deliberate narrowing is what keeps typing a role name from
        // repainting the whole gallery.
        //
        // Fragile long-term, though: the guarantee holds only while paletteScales
        // reads nothing outside `state.roles`. The real fix is to move `name` out of
        // RoleFields into a separate `names` record, which would make `[state.roles]`
        // an honest, complete dependency array and let this entry be deleted.
        //
        // It is NOT free, though — measured 2026-08-23 from the dev-server console:
        //   react-compiler(PreserveManualMemo): Existing memoization could not be
        //   preserved. The inferred dependency was `state`, but the source
        //   dependencies were [rampKey]. React Compiler skipped optimizing this
        //   component or hook.
        // So the hand-written narrowing costs PaletteProvider all React Compiler
        // optimization. It still cannot serve stale colors, but the RoleFields
        // refactor above would buy the whole component back. Worth doing.
        "files": ["src/components/palette/palette-provider.tsx"],
        "rules": ["react-doctor/exhaustive-deps"]
      },
      {
        // jsx-no-constructed-context-values — chart.tsx:65 `value={{ config }}` and
        // toggle-group.tsx:48 `value={{ orientation, size, spacing, variant }}`.
        //
        // The rule's own metadata says "Disabled when: react-compiler". This project
        // runs React Compiler via `viteReact({ compiler: true })` in vite.config.ts,
        // but react-doctor only detects `babel-plugin-react-compiler` or
        // `reactCompilerPreset` (see its isCompilerTransformModule check), so it
        // misses plugin-react v6's oxc-based `compiler` option and the rule fires
        // when it should have been switched off.
        //
        // Verified by running the real transform (oxc-transform-react) over both
        // files: compiler-runtime is imported, cache slots are allocated, zero
        // bailout errors, and the context objects are memoized exactly as the fix
        // prompt asks. ToggleGroup compiles to:
        //   if ($[12] !== orientation || $[13] !== size ||
        //       $[14] !== spacing   || $[15] !== variant) {
        //     t6 = { orientation, size, spacing, variant }; $[16] = t6;
        //   } else { t6 = $[16]; }          // same identity reused
        //   ... _jsx(ToggleGroupContext.Provider, { value: t6, ... })
        // chart.tsx compiles to the equivalent `t3 = { config }` cached on `config`.
        //
        // Adding a manual useMemo would be redundant, would diverge these vendored
        // shadcn files from upstream, and would risk tripping react-doctor's own
        // react-compiler-no-manual-memoization rule.
        "files": [
          "src/components/ui/chart.tsx",
          "src/components/ui/toggle-group.tsx"
        ],
        "rules": ["react-doctor/jsx-no-constructed-context-values"]
      },
      {
        // rerender-memo-before-early-return — chart.tsx:147, the `tooltipLabel`
        // useMemo in ChartTooltipContent sitting above `if (!(active && payload?.length))`.
        //
        // The rule page calls this "a profiling lead, not proof of wasted JSX work",
        // and its fix prompt says: "Keep the code unless profiling shows that
        // dependency changes frequently recompute expensive JSX on a path that
        // usually returns early. Do not add a child/memo wrapper solely to move this
        // hook below a branch." No profile shows that, and the memo's own first line
        // is `if (hideLabel || !payload?.length) return null` — so on exactly the
        // renders that take the early return, the callback bails immediately rather
        // than building JSX. It is P3/unranked and tagged test-noise.
        //
        // React Compiler also compiles this file cleanly (4 cache regions, 0 bailouts),
        // so the memo is preserved rather than skipped.
        "files": ["src/components/ui/chart.tsx"],
        "rules": ["react-doctor/rerender-memo-before-early-return"]
      },
      {
        // no-fetch-in-effect — the debounced `/api/color-name` lookup.
        //
        // The rule page documents the exception directly: "Suppress when: a
        // one-shot fetch with proper AbortController cleanup in a small project
        // that has not adopted a data-fetching library." All three now hold —
        // an AbortController was added alongside this entry, and neither
        // @tanstack/react-query nor swr is a dependency.
        //
        // Its prescribed fix does not fit either. A route loader or server
        // function is the wrong shape: this resolves names for whatever hexes
        // the user is dragging *right now*, not for a navigation. And the fetch
        // exists precisely so the ~1.3 MB name catalogue never enters a client
        // bundle — see the module header.
        //
        // The hook already does by hand what a fetching library would: debounce
        // (SETTLE_MS), a per-hex cache, batching (MAX_BATCH), abort-on-supersede,
        // and an aborted-signal check before any setState. The detector is purely
        // syntactic — it matches `fetch` anywhere inside useEffect — so no amount
        // of correctness here clears it.
        "files": ["src/hooks/use-color-names.ts"],
        "rules": ["react-doctor/no-fetch-in-effect"]
      },
      {
        // deslop/unused-file — tolgee.config.cjs is NOT unreachable; deleting it
        // would break `bun run i18n:pull` / `push` / `sync` / `compare`.
        //
        // The Tolgee CLI loads it through `cosmiconfig('tolgee')` (see
        // node_modules/@tolgee/cli/dist/config/tolgeerc.js), which discovers
        // `tolgee.config.cjs` by filename at runtime. Dead-code analysis only
        // walks the bundler's import graph, so a config found by convention has
        // no edge pointing at it and reads as orphaned.
        //
        // The file also loads .env.local for the CLI, which `bun run` does not
        // forward on its own — so it carries behaviour, not just settings.
        "files": ["tolgee.config.cjs"],
        "rules": ["deslop/unused-file"]
      }
    ]
  }
}
